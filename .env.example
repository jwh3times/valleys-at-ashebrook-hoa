# Copy this file to ".env" and fill in the values.
# Everything here is exposed to the browser (Astro only ships PUBLIC_* vars to
# the client). That is fine for these keys — security is enforced by
# Cloudflare D1/R2 access controls and server-side authorization, not by hiding
# these values.

# --- Cloudflare Turnstile ---
# Browser-visible widget key. The matching secret belongs in .dev.vars.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Public Google Calendar ---
# The calendar's ID (Google Calendar > Settings > "Integrate calendar" >
# Calendar ID). Often looks like xxxxx@group.calendar.google.com.
PUBLIC_GOOGLE_CALENDAR_ID=
# Optional: the timezone used by the embedded calendar.
PUBLIC_GOOGLE_CALENDAR_TIMEZONE=America/New_York

# --- Public contact form ---
# Browser-visible Web3Forms access key. Restrict it to the production domain
# in the provider dashboard.
PUBLIC_WEB3FORMS_KEY=
