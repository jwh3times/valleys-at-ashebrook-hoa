{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // The Node-side files are checked by tsconfig.node.json instead. Keeping the
  // runtime programs separate lets each one select its own libraries and test
  // globals; `npm run check` runs both programs.
  "exclude": [
    "dist",
    "scripts",
    "test/unit",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.shared.ts",
    "vitest.workers.config.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
