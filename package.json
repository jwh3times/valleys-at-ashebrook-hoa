{
  "name": "valleys-at-ashebrook-hoa",
  "type": "module",
  "version": "0.4.0",
  "description": "Resident-run website for The Valleys at Ashebrook",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "types:worker": "wrangler types --env-file .env.example",
    "types:worker:check": "wrangler types --env-file .env.example --check",
    "check": "astro sync && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && node vendor/astro-check-ts6/node_modules/@astrojs/check/bin/astro-check.js --root .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ashebrook-hoa --local",
    "db:migrate:remote": "wrangler d1 migrations apply ashebrook-hoa --remote",
    "auth:generate": "npx @better-auth/cli generate --output src/server/db/auth-schema.ts",
    "test:server": "vitest run --config vitest.workers.config.ts",
    "sync:agents": "node --experimental-strip-types scripts/sync-agent-skills.ts",
    "lint:coercions": "node --experimental-strip-types scripts/check-coercions.ts",
    "postinstall": "npm ci --prefix vendor/astro-check-ts6 --ignore-scripts --no-audit --no-fund",
    "roster:import": "node --experimental-strip-types scripts/import-roster.ts",
    "docs:import": "node --experimental-strip-types scripts/import-documents.ts",
    "docs:dedupe": "node --experimental-strip-types scripts/dedupe-documents.ts",
    "corpus:import": "node --experimental-strip-types scripts/import-corpus.ts",
    "ocr:scanned": "node --experimental-strip-types scripts/ocr-scanned.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/react": "^6.0.2",
    "astro": "^7.2.0",
    "better-auth": "^1.6.26",
    "better-auth-cloudflare": "^0.3.1",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@napi-rs/canvas": "^1.0.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.110.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "miniflare": {
      "undici": "7.29.0",
      "sharp": "0.35.2"
    }
  }
}
