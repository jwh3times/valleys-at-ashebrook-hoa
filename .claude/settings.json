{
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run db:migrate:local:*)",
      "Bash(npm run deploy:check:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint:fix:*)",
      "Bash(npm run lint:coercions:*)",
      "Bash(npm run lint:migrations:*)",
      "Bash(npm run lint:fixtures:*)",
      "Bash(npm run sync:agents:*)",
      "Bash(npm run sync:agents:check:*)",
      "Bash(node scripts/sync-agents.mjs:*)",
      "Bash(node --test scripts/sync-agents.test.mjs:*)",
      "Bash(npm run test:*)",
      "Bash(npm run test:server:*)",
      "Bash(npm run test:watch:*)",
      "Bash(npm run types:worker:*)",
      "Bash(npm run types:worker:check:*)",
      "Bash(npm run verify:invariants:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project view *)",
      "Bash(gh label list *)",
      "Bash(gh run watch *)",
      "Bash(git fetch -q --tags origin)",
      "Bash(git fetch -q origin)",
      "Bash(git fetch -q --prune origin)",
      "Bash(git fetch -q --tags)",
      "Bash(git fetch -q --prune --tags origin)",
      "Bash(git fetch -q)",
      "Bash(git -C private status *)",
      "Bash(git -C private fetch -q)",
      "Bash(git -C private stash list)",
      "Bash(node scripts/check-changelog.mjs *)",
      "Bash(node scripts/next-version.mjs *)",
      "Bash(node scripts/check-skills.mjs *)",
      "Bash(node scripts/check-docs.mjs *)",
      "Bash(npm run -s sync:agents:check *)",
      "Bash(npm run -s lint *)",
      "Bash(npm run -s check *)",
      "Bash(npm run -s format:check *)",
      "Bash(npm run -s types:worker:check *)",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__cloudflare-api__docs",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PROJECT_DIR/scripts/require-production-confirmation.ts\" || exit 2",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/sync-agents.mjs --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
