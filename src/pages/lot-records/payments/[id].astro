---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { DEFAULT_SITE_SETTINGS } from '../../../lib/types';
import { associationDateIso, formatDate } from '../../../lib/format';
import { paymentsReadable } from '../../../server/payments/gate';
import { fetchMemberPayment } from '../../../server/lot-records/reads';
import PaymentStatus from '../../../components/member/PaymentStatus';

/**
 * ONE ONLINE PAYMENT, WHERE THE PROVIDER SENDS THE HOMEOWNER BACK (ADR 0025,
 * #542).
 *
 * It shows the payment's STORED status and nothing else. The provider's
 * return address may carry a query string, and a page that believed it would
 * tell a homeowner "received" for money that has not settled; so nothing here
 * reads `Astro.url.search`. A bank payment shows "processing" for days, which
 * is the truth.
 *
 * Reading a payment needs `officialMode`, `lotRecordsEnabled` and a
 * configured provider, but not `onlinePaymentsEnabled`: a homeowner can always
 * see a payment already in flight. A payment the reader may not see — someone
 * else's, one from before their own period, or none at all — is the generic
 * 404, so the page never confirms that a payment id exists.
 *
 * The status is the one island (#544): server-rendered from the stored status,
 * so without JavaScript the page still tells the truth, and with it the island
 * asks the server to check with the provider a bounded number of times while
 * the payment may still settle.
 */

const site = Astro.locals.site ?? DEFAULT_SITE_SETTINGS;
if (!paymentsReadable(site, env)) {
  return Astro.rewrite('/404');
}

const ctx = Astro.locals.authContext ?? null;
const today = associationDateIso();
// Anonymous readers are asked to sign in before anything is looked up, so the
// prompt is the same for every id.
const payment = ctx
  ? await fetchMemberPayment(env, ctx.personId, Astro.params.id ?? '', today)
  : null;
if (ctx && !payment) {
  return Astro.rewrite('/404');
}

// Built here rather than in the markup, so no line break lands as a space
// before the full stop.
const startedLine = payment
  ? 'Started ' +
    formatDate(associationDateIso(new Date(payment.createdAt))) +
    (payment.providerPaymentRef
      ? ' · Reference ' + payment.providerPaymentRef
      : '') +
    '.'
  : '';

// One household's payment, rendered into the page: never cacheable.
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout title="Your payment" description="An online dues payment.">
  <div class="page-section">
    <p class="eyebrow">Lot records</p>
    <h1 class="page-title" style="margin-bottom: 36px;">
      Your payment
    </h1>

    {!payment ? (
      <p class="page-lead">
        Sign in to see this payment. <a href="/login">Sign in</a>.
      </p>
    ) : (
      <section class="lot-record">
        <h2 class="lot-record__address">{payment.address}</h2>
        <p class="muted">{startedLine}</p>
        <PaymentStatus
          client:load
          paymentId={payment.id}
          amountCents={payment.amountCents}
          status={payment.status}
          ledgerState={payment.ledgerState}
        />
        <p>
          <a href="/lot-records">Back to your lot records</a>
        </p>
      </section>
    )}
  </div>
</BaseLayout>
