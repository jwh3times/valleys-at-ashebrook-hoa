---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutDescription, aboutParagraphs, hasAboutPage } from '../lib/site';
import { DEFAULT_SITE_SETTINGS } from '../lib/types';

const site = Astro.locals.site ?? DEFAULT_SITE_SETTINGS;

if (!hasAboutPage(site)) {
  return Astro.rewrite('/404');
}
---

<BaseLayout title="About this site" description={aboutDescription(site)}>
  <div class="page-section">
    <p class="eyebrow">About</p>
    <h1 class="page-title">About this site</h1>
    <div class="prose">
      {aboutParagraphs(site).map((para) => (
        <p class="page-lead">{para}</p>
      ))}
    </div>
  </div>
</BaseLayout>
